#!/usr/bin/env bash

# Set default mode to bsp (unmanaged apps float via rules below)
yabai -m config layout bsp

# Set default padding/gaps between windows
for param in \
    {top,bottom,left,right}_padding \
    window_gap ; do
    yabai -m config $param 5
done

yabai -m config split_ratio                 0.5
yabai -m config focus_follows_mouse         off
yabai -m config mouse_follows_focus         off
yabai -m config mouse_modifier              fn

# Explicitly define which apps can be managed
managed=(
    'iTerm2'
    'Firefox'
    'Safari'
    'Google Chrome'
    'Obsidian'
    'Mail'
    'Calendar'
    'Slack'
)
printf -v regex "%s|" "${managed[@]}"
regex="^(${regex%|})$"

yabai -m rule --add app!="$regex" manage=off

# Always float iTerm hotkey window
yabai -m rule --add app='^iTerm2$' title='^Hotkey Window$' manage=off

yabai -m rule --apply
